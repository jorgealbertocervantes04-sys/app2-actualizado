# ── Supabase (base de datos) ────────────────────────────────────
# Project Settings → API. La service role key es SECRETA: solo servidor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Administración ──────────────────────────────────────────────
# Clave del panel /admin (obligatoria, sin valor por defecto)
ADMIN_CODE=

# ── Evaluador IA (gateway Kimi) ─────────────────────────────────
# Si se omiten, las respuestas abiertas se puntúan con rúbrica local de respaldo
KIMI_AGENTGW_BASE_URL=https://agent-gw.kimi.com/coding/v1
KIMI_AGENTGW_API_KEY=
