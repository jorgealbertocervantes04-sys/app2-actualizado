# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Google Sheets (base de datos) ───────────────────────────────
# URL del Web App de Apps Script desplegado sobre tu hoja
# (termina en /exec). Pasos completos en INSTRUCCIONES.md
GOOGLE_SHEETS_URL=
GOOGLE_SHEETS_TOKEN=      # debe ser el mismo TOKEN que pusiste en google-sheets.gs

# ── Administración ──────────────────────────────────────────────
ADMIN_CODE=               # clave del panel /admin (por defecto ADMIN-2026 — cámbiala)

# ── Evaluador IA (gateway Kimi) ─────────────────────────────────
# Si se omiten, las respuestas abiertas se puntúan con rúbrica local de respaldo
KIMI_AGENTGW_BASE_URL=https://agent-gw.kimi.com/coding/v1
KIMI_AGENTGW_API_KEY=
